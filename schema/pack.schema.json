{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kylebegeman/corbelo-game-export/main/schema/pack.schema.json",
  "title": "corbelo-game-export pack",
  "description": "What scenes[0].extras.corbeloGameExport holds in a GLB this package wrote: the engine profile used, the facts measured from the written geometry, and whatever provenance the caller passed in. The facts on their own are #/$defs/PackFacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "facts"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "profile": {
      "$ref": "#/$defs/EngineProfile"
    },
    "facts": {
      "$ref": "#/$defs/PackFacts"
    },
    "provenance": {
      "description": "Opaque JSON from the caller, stored as given."
    }
  },
  "$defs": {
    "Vec3": {
      "description": "x, y, z.",
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "Box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "size"
      ],
      "properties": {
        "min": {
          "$ref": "#/$defs/Vec3"
        },
        "max": {
          "$ref": "#/$defs/Vec3"
        },
        "size": {
          "$ref": "#/$defs/Vec3"
        }
      }
    },
    "MeasuredBox": {
      "description": "The same box twice: in glTF space (metres, +Y up) and in the engine's unit, with the up axis moved to the engine's up axis.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meters",
        "engine"
      ],
      "properties": {
        "meters": {
          "$ref": "#/$defs/Box"
        },
        "engine": {
          "$ref": "#/$defs/Box"
        }
      }
    },
    "PivotMode": {
      "enum": [
        "base-center",
        "center",
        "min-corner",
        "origin",
        "point"
      ]
    },
    "PivotFacts": {
      "description": "A pivot in glTF space, in the engine's unit and axes, and in the caller's units and axes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "meters",
        "engine",
        "source"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/PivotMode"
        },
        "meters": {
          "$ref": "#/$defs/Vec3"
        },
        "engine": {
          "$ref": "#/$defs/Vec3"
        },
        "source": {
          "$ref": "#/$defs/Vec3"
        }
      }
    },
    "BodyFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sourceName",
        "node",
        "mesh",
        "triangles",
        "vertices",
        "materialSlots",
        "materials",
        "degenerateTrianglesDropped",
        "openEdges",
        "nonManifoldEdges",
        "bounds",
        "localBounds",
        "pivot",
        "translation"
      ],
      "properties": {
        "name": {
          "description": "The node name as written, and the mesh name too, except where detail levels are laid out as a group: there the body's node is empty and its full-detail mesh is named as level 0.",
          "type": "string"
        },
        "sourceName": {
          "description": "The name the caller gave.",
          "type": "string"
        },
        "node": {
          "type": "integer",
          "minimum": 0
        },
        "mesh": {
          "type": "integer",
          "minimum": 0,
          "description": "Index of the full-detail mesh."
        },
        "triangles": {
          "type": "integer",
          "minimum": 1
        },
        "vertices": {
          "description": "Vertices written, after splitting along hard edges and between colours.",
          "type": "integer",
          "minimum": 3
        },
        "materialSlots": {
          "description": "Primitives of the mesh: one for each colour the written triangles have.",
          "type": "integer",
          "minimum": 1
        },
        "materials": {
          "description": "Material names, one per slot.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "slots": {
          "description": "Only for a body with more than one material slot: what each slot holds, in slot order. The triangles add up to the body's triangles and the vertices to its vertices.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotFacts"
          },
          "minItems": 2
        },
        "shadedFrom": {
          "description": "Only for a body given refines: how many surfaces its shading was taken from and how many triangles they hold together.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "surfaces",
            "triangles"
          ],
          "properties": {
            "surfaces": {
              "type": "integer",
              "minimum": 1
            },
            "triangles": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "degenerateTrianglesDropped": {
          "type": "integer",
          "minimum": 0
        },
        "openEdges": {
          "description": "Edges used by exactly one triangle. Zero for a closed body.",
          "type": "integer",
          "minimum": 0
        },
        "nonManifoldEdges": {
          "description": "Edges used by more than two triangles.",
          "type": "integer",
          "minimum": 0
        },
        "bounds": {
          "$ref": "#/$defs/MeasuredBox"
        },
        "localBounds": {
          "$ref": "#/$defs/MeasuredBox"
        },
        "pivot": {
          "$ref": "#/$defs/PivotFacts"
        },
        "translation": {
          "$ref": "#/$defs/Vec3"
        },
        "collision": {
          "description": "Only from exportGameAsset, when collision was asked for.",
          "$ref": "#/$defs/CollisionFacts"
        },
        "lods": {
          "description": "Only from exportGameAsset, for a body given lower detail levels: every level, level 0 first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LodFacts"
          },
          "minItems": 2
        },
        "attachPoints": {
          "description": "Only from exportGameAsset, for a body given attach points.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttachPointFacts"
          },
          "minItems": 1
        }
      }
    },
    "SlotFacts": {
      "description": "One material slot of a body: one primitive of its mesh.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material",
        "triangles",
        "vertices"
      ],
      "properties": {
        "material": {
          "description": "Material name.",
          "type": "string"
        },
        "triangles": {
          "type": "integer",
          "minimum": 1
        },
        "vertices": {
          "type": "integer",
          "minimum": 3
        }
      }
    },
    "CollisionShape": {
      "description": "A collision shape, cheapest first.",
      "enum": [
        "box",
        "hull",
        "pieces",
        "decomposition"
      ]
    },
    "CollisionRequest": {
      "description": "none writes no collision. auto takes the cheapest shape whose volume is near enough the visible part's.",
      "enum": [
        "none",
        "auto",
        "box",
        "hull",
        "pieces",
        "decomposition"
      ]
    },
    "CollisionTierFacts": {
      "description": "A tier of collision that was built and measured.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "pieces",
        "volume",
        "error",
        "withinTolerance"
      ],
      "properties": {
        "shape": {
          "$ref": "#/$defs/CollisionShape"
        },
        "pieces": {
          "type": "integer",
          "minimum": 1
        },
        "volume": {
          "description": "Cubic metres: the volumes of the pieces added up.",
          "type": "number",
          "minimum": 0
        },
        "error": {
          "description": "(volume - visible) / visible. Null when the body has no volume to compare with.",
          "type": [
            "number",
            "null"
          ]
        },
        "withinTolerance": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "CollisionNodeFacts": {
      "description": "One node of a collision shape: one convex piece.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "node",
        "mesh",
        "kind",
        "role",
        "vertices",
        "triangles",
        "volume",
        "capped",
        "bounds"
      ],
      "properties": {
        "name": {
          "description": "The node and mesh name as written, in the way the engine reads it.",
          "type": "string"
        },
        "node": {
          "type": "integer",
          "minimum": 0
        },
        "mesh": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "description": "box is the box around the body. Everything else is convex.",
          "enum": [
            "box",
            "convex"
          ]
        },
        "role": {
          "description": "What the profile says the engine does with the name. Null when the profile has no rule for it.",
          "anyOf": [
            {
              "$ref": "#/$defs/NodeRole"
            },
            {
              "type": "null"
            }
          ]
        },
        "vertices": {
          "type": "integer",
          "minimum": 4
        },
        "triangles": {
          "type": "integer",
          "minimum": 4
        },
        "volume": {
          "description": "Cubic metres.",
          "type": "number",
          "minimum": 0
        },
        "capped": {
          "description": "True when the piece was stopped at the most corners allowed and left points outside.",
          "type": "boolean"
        },
        "bounds": {
          "$ref": "#/$defs/MeasuredBox"
        }
      }
    },
    "CollisionFacts": {
      "description": "The collision shape of one body.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "shape",
        "pieces",
        "tolerance",
        "volume",
        "withinTolerance",
        "nodes",
        "tried",
        "notes"
      ],
      "properties": {
        "requested": {
          "$ref": "#/$defs/CollisionRequest"
        },
        "shape": {
          "description": "The shape written. none when none was asked for or none could be built.",
          "anyOf": [
            {
              "$ref": "#/$defs/CollisionShape"
            },
            {
              "const": "none"
            }
          ]
        },
        "pieces": {
          "description": "How many convex pieces, and so how many nodes.",
          "type": "integer",
          "minimum": 0
        },
        "tolerance": {
          "description": "How far the collision volume may be from the visible volume, as a share of it.",
          "type": "number",
          "minimum": 0
        },
        "maxPieces": {
          "description": "The most convex pieces a decomposition of this body makes. Not in files written before 0.1.8.",
          "type": "integer",
          "minimum": 1
        },
        "maxHullVertices": {
          "description": "The most corners one convex piece of this body has. Not in files written before 0.1.8.",
          "type": "integer",
          "minimum": 4
        },
        "volume": {
          "description": "Cubic metres. visible and error are null for a body that is not closed.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visible",
            "collision",
            "error"
          ],
          "properties": {
            "visible": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "collision": {
              "type": "number",
              "minimum": 0
            },
            "error": {
              "description": "(collision - visible) / visible.",
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "withinTolerance": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CollisionNodeFacts"
          }
        },
        "tried": {
          "description": "Every tier that was built on the way, cheapest first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CollisionTierFacts"
          }
        },
        "notes": {
          "description": "Why a tier was passed over, or why there is no shape.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "LodFacts": {
      "description": "One detail level of a body. Level 0 is the full detail.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "name",
        "node",
        "mesh",
        "visible",
        "triangles",
        "vertices",
        "materialSlots",
        "materials",
        "degenerateTrianglesDropped",
        "openEdges",
        "nonManifoldEdges",
        "deviation"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "description": "The node and mesh name as written.",
          "type": "string"
        },
        "node": {
          "type": "integer",
          "minimum": 0
        },
        "mesh": {
          "type": "integer",
          "minimum": 0
        },
        "visible": {
          "description": "False for a level written hidden with KHR_node_visibility, for the game to show in its turn.",
          "type": "boolean"
        },
        "triangles": {
          "type": "integer",
          "minimum": 1
        },
        "vertices": {
          "type": "integer",
          "minimum": 3
        },
        "materialSlots": {
          "type": "integer",
          "minimum": 1
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "degenerateTrianglesDropped": {
          "type": "integer",
          "minimum": 0
        },
        "openEdges": {
          "type": "integer",
          "minimum": 0
        },
        "nonManifoldEdges": {
          "type": "integer",
          "minimum": 0
        },
        "deviation": {
          "description": "How far the outline moved from level 0: the greatest distance from a vertex or the middle of a triangle of either mesh to the nearest point of the other. share is that distance over the diagonal of the box around level 0. All zero for level 0.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "meters",
            "engine",
            "share"
          ],
          "properties": {
            "meters": {
              "type": "number",
              "minimum": 0
            },
            "engine": {
              "type": "number",
              "minimum": 0
            },
            "share": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "AttachPointFacts": {
      "description": "A named point on a body, written as an empty node.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sourceName",
        "node",
        "meters",
        "engine",
        "source"
      ],
      "properties": {
        "name": {
          "description": "The node name as written.",
          "type": "string"
        },
        "sourceName": {
          "description": "The name the caller gave.",
          "type": "string"
        },
        "node": {
          "type": "integer",
          "minimum": 0
        },
        "meters": {
          "description": "Where the point is in the scene: metres, +Y up.",
          "$ref": "#/$defs/Vec3"
        },
        "engine": {
          "description": "The same in the engine's unit and up axis.",
          "$ref": "#/$defs/Vec3"
        },
        "source": {
          "description": "The same in the caller's units and axes.",
          "$ref": "#/$defs/Vec3"
        },
        "direction": {
          "description": "Only with a direction: the way the node's +Z axis points, in glTF axes, at length 1.",
          "$ref": "#/$defs/Vec3"
        }
      }
    },
    "MaterialFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "color",
        "baseColorFactor",
        "bodies"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "color": {
          "description": "sRGB.",
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "baseColorFactor": {
          "description": "Linear, as written to the file.",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        },
        "bodies": {
          "description": "How many bodies have a triangle in it.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "TotalFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bodies",
        "triangles",
        "vertices",
        "materialSlots",
        "degenerateTrianglesDropped",
        "openEdges",
        "nonManifoldEdges",
        "bounds"
      ],
      "properties": {
        "bodies": {
          "type": "integer",
          "minimum": 1
        },
        "triangles": {
          "type": "integer",
          "minimum": 1
        },
        "vertices": {
          "type": "integer",
          "minimum": 3
        },
        "materialSlots": {
          "description": "Distinct materials in the file.",
          "type": "integer",
          "minimum": 1
        },
        "degenerateTrianglesDropped": {
          "type": "integer",
          "minimum": 0
        },
        "openEdges": {
          "type": "integer",
          "minimum": 0
        },
        "nonManifoldEdges": {
          "type": "integer",
          "minimum": 0
        },
        "bounds": {
          "$ref": "#/$defs/MeasuredBox"
        }
      }
    },
    "NodeRole": {
      "enum": [
        "collision-trimesh",
        "collision-convex",
        "collision-trimesh-only",
        "collision-convex-only",
        "collision-box",
        "collision-sphere",
        "collision-capsule",
        "lod"
      ]
    },
    "NodeNameConvention": {
      "description": "One node-name rule an engine's importer reads.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "affix",
        "text",
        "pattern"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/NodeRole"
        },
        "affix": {
          "enum": [
            "prefix",
            "suffix"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "pattern": {
          "description": "How a full node name is built. {name} is the render node's name, {n} counts from 0 and {nn} is the same counter with two digits.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "EngineProfile": {
      "description": "Facts about a target engine: its unit, its up axis and the node names its importer acts on.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "unit",
        "unitMeters",
        "up",
        "conventions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "description": "For people.",
          "type": "string"
        },
        "unit": {
          "description": "The engine's unit, for people: m or cm.",
          "type": "string"
        },
        "unitMeters": {
          "description": "Metres per engine unit.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "up": {
          "enum": [
            "Y",
            "Z"
          ]
        },
        "conventions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "collision",
            "lod"
          ],
          "properties": {
            "collision": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/NodeNameConvention"
              }
            },
            "lod": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/NodeNameConvention"
              }
            }
          }
        }
      }
    },
    "PackFacts": {
      "description": "Everything measured from the geometry that was written. This is also the facts JSON file the command line writes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "generator",
        "profile",
        "engine",
        "source",
        "settings",
        "bodies",
        "materials",
        "total"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "generator": {
          "type": "string"
        },
        "profile": {
          "description": "Profile id.",
          "type": "string"
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "unitMeters",
            "up"
          ],
          "properties": {
            "unit": {
              "type": "string"
            },
            "unitMeters": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "up": {
              "enum": [
                "Y",
                "Z"
              ]
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "up",
            "handedness"
          ],
          "properties": {
            "unit": {
              "description": "Metres per source unit.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "up": {
              "enum": [
                "Y",
                "Z"
              ]
            },
            "handedness": {
              "enum": [
                "right",
                "left"
              ]
            }
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pivot",
            "placement",
            "creaseAngle",
            "normals",
            "weldTolerance",
            "faceIds"
          ],
          "properties": {
            "pivot": {
              "$ref": "#/$defs/PivotMode"
            },
            "placement": {
              "enum": [
                "origin",
                "designed",
                "assembly"
              ]
            },
            "creaseAngle": {
              "type": "number",
              "minimum": 0,
              "maximum": 180
            },
            "normals": {
              "enum": [
                "angle-area",
                "face-weighted"
              ]
            },
            "weldTolerance": {
              "type": "number",
              "minimum": 0
            },
            "faceIds": {
              "type": "boolean"
            },
            "texcoords": {
              "description": "Only from exportGameAsset, with texture coordinates.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "projection",
                "tileMeters"
              ],
              "properties": {
                "projection": {
                  "const": "box"
                },
                "tileMeters": {
                  "description": "The side of one whole texture in the world, in metres.",
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "collision": {
              "description": "Only from exportGameAsset: what collision was asked for.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "shape",
                "tolerance",
                "maxPieces",
                "maxHullVertices",
                "kernel"
              ],
              "properties": {
                "shape": {
                  "$ref": "#/$defs/CollisionRequest"
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                },
                "maxPieces": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxHullVertices": {
                  "type": "integer",
                  "minimum": 4
                },
                "kernel": {
                  "description": "True when the caller passed a kernel in, so a general convex decomposition could be built.",
                  "type": "boolean"
                }
              }
            },
            "lodLayout": {
